# ===================== Python =====================
# 字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.pyc

# 打包 / 分发
build/
dist/
*.egg-info/
*.egg

# ===================== 虚拟环境 =====================
venv/
env/
ENV/
.venv/

# ===================== Django =====================
# 本地数据库文件
*.sqlite3
db.sqlite3

# 日志
*.log

# 用户上传的媒体文件（本地测试上传内容，不提交）
media/

# 静态文件收集目录（若运行过 collectstatic）
staticfiles/

# ===================== IDE / 编辑器 =====================
.idea/
.vscode/
*.swp
*.swo
*~

# ===================== 敏感配置 =====================
